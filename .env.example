# Copy this file to ".env" for local use and fill in what you need. Restart the server after changes.
# On Render / a server, set the same names as environment variables instead.
# Never share or commit your real .env file.

# ---------- Business ----------
# SITE_NAME=ResumeForge Pro
# BUSINESS_NAME=Your Registered Business Name      # shown in Terms, Privacy, footer
# SUPPORT_EMAIL=support@yourdomain.com             # Contact page + receives contact-form messages
# ADMIN_EMAILS=you@gmail.com                       # these accounts can open /admin

# ---------- AI (Claude) ----------
# Get a key at https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5

# ---------- Plans & prices (paise: ₹1 = 100) ----------
# PRICE_PRO_1M=19900
# PRICE_PRO_3M=44900
# PRICE_PRO_12M=119900
# FREE_RESUMES=3
# FREE_AI_DAILY=3
# PRO_RESUMES=50
# PRO_AI_DAILY=60

# ---------- Payments (Razorpay) ----------
# Dashboard -> Account & Settings -> API Keys. Use rzp_test_ keys until your account is activated.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxx
# Dashboard -> Webhooks -> URL https://yourdomain.com/api/billing/webhook, events payment.captured + order.paid
# RAZORPAY_WEBHOOK_SECRET=a-long-random-string

# ---------- Email (password-reset links) ----------
# Without SMTP the reset link is printed in the server window instead.
# Gmail: create an "App password" at https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-16-character-app-password
# SMTP_FROM=you@gmail.com

# ---------- Server ----------
# PORT=8000
# HOST=127.0.0.1                  # 0.0.0.0 on a server / in Docker
# APP_URL=http://localhost:8000   # your public https:// address when deployed (canonical URLs, sitemap, emails)
# COOKIE_SECURE=1                 # automatic when APP_URL starts with https://
# TRUST_PROXY=1                   # only behind a reverse proxy (Render, Caddy, nginx)
# RESUMEFORGE_DB=data/resumeforge.db
